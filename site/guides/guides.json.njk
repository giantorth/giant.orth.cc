---
permalink: /guides/guides.json
eleventyExcludeFromCollections: true
---
{#- Machine-readable guide list for the plugin's Help tab, in site order (grouped
    by category). Stays a flat array: older plugins ignore the category fields. -#}
[
{%- for g in collections.guides %}
  {%- set cat = g.data.category | guideCategory(guideCategories) %}
  {"slug": {{ g.fileSlug | dump | safe }}, "title": {{ g.data.title | dump | safe }}, "description": {{ g.data.description | dump | safe }}, "url": {{ ("https://giant.orth.cc" + g.url) | dump | safe }}, "category": {{ cat.slug | dump | safe }}, "categoryTitle": {{ cat.title | dump | safe }}}{% if not loop.last %},{% endif %}
{%- endfor %}
]
